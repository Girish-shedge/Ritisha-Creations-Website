# Google Drive catalogue (public folder + API key)
# Create a key: Google Cloud Console → APIs & Services → enable "Google Drive API"
# → Credentials → API key. Restrict to Drive API.
# HTTP referrers must include the value used by api/driveEnv.js
# (default https://ritishacreations.vercel.app/) plus localhost for local dev.
# Prefer setting GOOGLE_API_REFERER on Vercel if the allowlist changes.
VITE_GOOGLE_DRIVE_API_KEY=
VITE_DRIVE_FOLDER_ID=1blEF1JY8k4fGg66R_O1ZcSyN6wFHz9W8
# GOOGLE_API_REFERER=https://ritishacreations.vercel.app/
